# TUUUCKYTV - Hostinger clean URL support
# Keeps URLs such as /pipes while serving pipes.html underneath.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Leave real files and real directories alone.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # /pipes -> /pipes.html internally, /date -> /date.html, etc.
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
